# CoffeeCoder · variables de entorno
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgres://coffee:coffee@localhost:5432/coffeecoder?sslmode=disable

# Auth
JWT_SECRET=cambiame-en-produccion
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# OAuth (completar al configurar cada provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Video. VIDEO_PROVIDER=fake (solo development) reproduce FAKE_VIDEO_URL
# sin credenciales; bunny usa Bunny Stream.
VIDEO_PROVIDER=bunny
PLAYBACK_TTL=6h
# FAKE_VIDEO_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8

# Bunny Stream (Video Library → API / Security)
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=            # API key de la librería (lectura/escritura)
BUNNY_WEBHOOK_SECRET=     # API key de SOLO LECTURA de la librería (firma de webhooks)
BUNNY_TOKEN_AUTH_KEY=     # Token Authentication Key del pull zone de la librería
BUNNY_CDN_HOSTNAME=       # vz-xxxxxxxx-xxx.b-cdn.net

# Pagos. BILLING_PROVIDER=fake (solo development) simula el checkout sin
# credenciales: `make dev-pay ORDER=<id>` aprueba una orden.
BILLING_PROVIDER=mercadopago
BILLING_CURRENCY=ARS
BILLING_USD_RATE=          # cuántos ARS vale 1 USD (el catálogo está en USD)

# Mercado Pago (Tus integraciones → aplicación)
MP_ACCESS_TOKEN=           # credencial de prueba TEST-... o de producción
MP_WEBHOOK_SECRET=         # "clave secreta" del panel Webhooks

# Email (Resend). Sin API key en development los mails se loguean.
RESEND_API_KEY=
MAIL_FROM=CoffeeCoder <hola@coffeecoder.dev>
MAIL_REPLY_TO=
