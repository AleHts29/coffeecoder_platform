# CoffeeCoder · variables de entorno
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgres://coffee:coffee@localhost:5432/coffeecoder?sslmode=disable

# Auth
JWT_SECRET=cambiame-en-produccion
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# OAuth (completar al configurar cada provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Bunny Stream
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_TOKEN_AUTH_KEY=
BUNNY_CDN_HOSTNAME=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
